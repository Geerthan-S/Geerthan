NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser push (optional). Generate a key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduled push delivery (optional, server-only).
# CRON_SECRET: at least 32 random characters, e.g. `openssl rand -hex 32`.
# SUPABASE_SECRET_KEY: the project's secret key, used only by /api/cron/push-notifications.
CRON_SECRET=
SUPABASE_SECRET_KEY=

# Google Calendar import (optional, server-only). See README → Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored Google tokens; don't change it later.
INTEGRATION_ENCRYPTION_KEY=

# Error forwarding (optional): any HTTPS endpoint that accepts JSON events.
ERROR_WEBHOOK_URL=

# VAPID_PRIVATE_KEY, CRON_SECRET, SUPABASE_SECRET_KEY, GOOGLE_CLIENT_SECRET and
# INTEGRATION_ENCRYPTION_KEY are server-only.
# Never give them a NEXT_PUBLIC_ prefix or import them into browser code.
